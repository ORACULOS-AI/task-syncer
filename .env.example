# Configurações para o task-syncer
# Preencha os valores abaixo e salve como .env

JIRA_URL=https://seu-dominio.atlassian.net
JIRA_EMAIL=seu-email@exemplo.com
JIRA_API_TOKEN=seu-api-token

# Opcional: defina uma chave de projeto para sincronizar apenas um
# Exemplo: JIRA_PROJECT_KEY=SAAS
# Deixe vazio para sincronizar todos os projetos.
JIRA_PROJECT_KEY=
